            "off"
          ]
        },
        "script-hygiene": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "off"
          ]
        },
        "hardcoded-identifiers": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "off"
          ]
        },
        "client-script-safety": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "off"
          ]
        },
        "property-privacy": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "off"
          ]
        },
        "inactive-artifacts": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "off"
          ]
        },
        "notification-conditions": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "off"
          ]
        },
        "log-leftovers": {
          "type": "string",
          "enum": [
            "fail",
