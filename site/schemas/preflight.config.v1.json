          ]
        },
        "test-drift": {
          "type": "string",
          "enum": [
            "fail",
            "warn",
            "off"
          ]
        }
      },
      "additionalProperties": false
    },
    "failOn": {
      "description": "Fail the run on fail rows only, or on warn rows too.",
      "type": "string",
      "enum": [
        "fail",
        "warn"
      ]
    },
    "$schema": {}
  },
  "additionalProperties": false
}
