{
  "name": "servicenow-preflight",
  "version": "0.5.0",
  "description": "Pre-deployment preflight checks for ServiceNow — validate a target instance and your changes before you ship.",
  "license": "MIT",
  "author": "Ivan Baev <ivanbbaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanBBaev/servicenow-preflight.git"
  },
  "homepage": "https://ivanbbaev.github.io/servicenow-preflight/",
  "bugs": {
    "url": "https://github.com/IvanBBaev/servicenow-preflight/issues"
  },
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./checks": {
      "types": "./build/api/checks.d.ts",
      "import": "./build/api/checks.js",
      "default": "./build/api/checks.js"
    },
    "./http": {
      "types": "./build/api/http.d.ts",
      "import": "./build/api/http.js",
      "default": "./build/api/http.js"
    },
    "./report": {
      "types": "./build/api/report.d.ts",
      "import": "./build/api/report.js",
      "default": "./build/api/report.js"
    },
    "./state": {
      "types": "./build/api/state.d.ts",
      "import": "./build/api/state.js",
      "default": "./build/api/state.js"
    },
    "./testing": {
      "types": "./build/api/testing.d.ts",
      "import": "./build/api/testing.js",
      "default": "./build/api/testing.js"
    },
    "./internal": {
      "types": "./build/api/internal.d.ts",
      "import": "./build/api/internal.js",
      "default": "./build/api/internal.js"
    },
    "./schemas/report.v1.json": "./schemas/report.v1.json",
    "./schemas/finding.v1.json": "./schemas/finding.v1.json",
    "./schemas/preflight.config.v1.json": "./schemas/preflight.config.v1.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "servicenow-preflight": "./bin/servicenow-preflight.cjs",
    "snpf": "./bin/servicenow-preflight.cjs",
    "tess": "./bin/tess.cjs",
    "tessera-mcp": "./bin/tessera-mcp.cjs"
  },
  "files": [
    "build",
    "bin",
    "src",
    "schemas",
    "CHANGELOG.md",
    "!build/tessera/.stage-tessera.json",
    "!build/tessera/.npmignore"
  ],
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/IvanBBaev"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/ivanbbaev"
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "tsc --watch",
    "start": "node bin/servicenow-preflight.cjs",
    "dev": "npm run build && node bin/servicenow-preflight.cjs",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test --import ./test/setup/hermetic-env.js $(find test -name '*.test.js')",
    "test:coverage": "c8 --reporter=text-summary --reporter=lcov node --test --import ./test/setup/hermetic-env.js $(find test -name '*.test.js')",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run build && npm run lint && npm run format:check && node --test --import ./test/setup/hermetic-env.js $(find test -name '*.test.js')",
    "check": "npm run build && npm run gen:site -- --check && npm run gen:schema -- --check && npm run lint && npm run format:check && npm run test:coverage && npm run smoke:pack",
    "gen:site": "node scripts/gen-site.mjs",
    "gen:schema": "node scripts/gen-schema.mjs",
    "prepublishOnly": "npm run check",
    "stage:tessera": "node scripts/stage-tessera.mjs",
    "prepack": "node scripts/stage-tessera.mjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "smoke:sdist": "node scripts/sdist-smoke.mjs",
    "smoke:sdist:container": "node scripts/sdist-container.mjs",
    "record:sample": "node scripts/record-replay-sample.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "c8": "^11.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.8.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.61.0"
  },
  "keywords": [
    "servicenow",
    "service-now",
    "preflight",
    "cli",
    "deployment",
    "promote-gate",
    "validation",
    "devops",
    "ci",
    "atf",
    "update-set",
    "drift",
    "sarif",
    "junit"
  ]
}
